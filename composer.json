{
	"name": "ernilambar/maintainic",
	"description": "Simple maintenance plugin.",
	"license": "GPL-2.0-or-later",
	"type": "wordpress-plugin",
	"keywords": [
		"wordpress",
		"wordpress-plugin"
	],
	"authors": [
		{
			"name": "Nilambar Sharma",
			"email": "nilambar@outlook.com",
			"homepage": "https://www.nilambar.net/",
			"role": "Developer"
		}
	],
	"require": {
		"php": ">=8.0",
		"ernilambar/optiz": "^1.0"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"php-parallel-lint/php-parallel-lint": "dev-develop#f8cb90a",
		"phpcompatibility/php-compatibility": "^10",
		"slevomat/coding-standard": "^8.22",
		"wp-cli/i18n-command": "^3.0",
		"wp-cli/wp-cli": "^3.0",
		"wp-coding-standards/wpcs": "^3.4"
	},
	"repositories": [
		{
			"type": "vcs",
			"url": "https://github.com/ernilambar/optiz"
		}
	],
	"minimum-stability": "dev",
	"prefer-stable": true,
	"autoload": {
		"psr-4": {
			"Maintainic\\": "app/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"ergebnis/composer-normalize": true
		},
		"optimize-autoloader": true,
		"platform": {
			"php": "8.0"
		},
		"sort-packages": true
	},
	"scripts": {
		"format": "@php ./vendor/bin/phpcbf --report-full --report-summary",
		"lint": [
			"@lint-php",
			"@phpcs"
		],
		"lint-php": "@php ./vendor/bin/parallel-lint --colors --exclude .git --exclude vendor --exclude node_modules --exclude deploy .",
		"mo": "./vendor/bin/wp i18n make-mo languages/",
		"phpcs": "@php ./vendor/bin/phpcs --report-full --report-summary .",
		"po": "./vendor/bin/wp i18n update-po languages/maintainic.pot languages/",
		"pot": "./vendor/bin/wp i18n make-pot . --exclude=build,deploy,node_modules,vendor --headers='{\"POT-Creation-Date\":\"\"}'"
	}
}
